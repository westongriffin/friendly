rules_version = '2';
// Friendly — Firestore security rules.
// Real per-group privacy is enforced HERE, on the server. A signed-in stranger
// can never read a group, event, or expense they aren't part of.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function email() { return request.auth.token.email; }
    // App moderators: may read the report queue and remove any user content.
    // Keep in sync with adminUids in firebase-config.js and functions/index.js.
    function isAdmin() {
      return signedIn() && uid() in ['zzJY7MHFnyN2kAqq13hv79rZTVF2', 'TUngQGsAKTRtHBpVEpZwFFHE0sP2'];
    }

    // ---- Activity feed: written by Cloud Functions, readable by its recipients ----
    match /activity/{itemId} {
      allow read: if signedIn() && uid() in resource.data.uids;
    }

    // ---- Public previews of "anyone with the link" events (written by functions) ----
    match /previews/{eventId} { allow read: if true; }

    // ---- Nudges: a host asks the function to remind non-responders ----
    match /nudges/{nudgeId} {
      allow create: if signedIn() && request.resource.data.by == uid();
    }

    // ---- Reports: anyone signed in can file one; only admins see them ----
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == uid()
        && request.resource.data.status == "open";
      allow read, update, delete: if isAdmin();
    }

    // Public demo sandbox (see functions/index.js seedDemoData). These three
    // accounts are reachable by anyone on the internet, so everything that could
    // touch a real person or cost real money is refused HERE, not just in the UI:
    // no phone/email invites, no non-demo people in their groups/events/expenses,
    // no paid AI requests, no deleting the seeded fixtures, no identity changes.
    function demoUids() { return ['demo-riley', 'demo-jordan', 'demo-casey']; }
    function isDemoUser() { return signedIn() && uid() in demoUids(); }
    function demoGroupOk(d) {
      return d.memberUids.hasOnly(demoUids()) && d.get('hostUids', []).hasOnly(demoUids())
        && d.get('invitedEmails', []).size() == 0 && d.get('invitedPhones', []).size() == 0;
    }
    function demoEventOk(d) {
      return d.invitedUids.hasOnly(demoUids()) && d.get('cohostUids', []).hasOnly(demoUids())
        && d.get('invitedPhones', []).size() == 0 && d.get('guestEmails', []).size() == 0;
    }

    function groupMemberUids(gid) {
      return get(/databases/$(database)/documents/groups/$(gid)).data.memberUids;
    }

    // ---- Users: each profile is private to its owner ----
    match /users/{userId} {
      allow read: if signedIn() && userId == uid();
      allow create: if signedIn() && userId == uid() && !isDemoUser();
      allow update: if signedIn() && userId == uid()
        && (!isDemoUser() || request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'venmo', 'zelle', 'cashapp', 'payPref', 'city', 'photo', 'birthday', 'notifPrefs', 'activitySeenAt', 'hiddenIds', 'blockedUids', 'onboarded']));
      allow delete: if signedIn() && userId == uid() && !isDemoUser();
    }

    // ---- Groups ----
    // Doc shape: { name, emoji, ownerId, memberUids[], invitedEmails[],
    //              members: { <uid>: {name, venmo, phone} }, createdAt }
    match /groups/{groupId} {
      // Phone invites: the user's normalized number (users/{uid}.phoneE164) is on the group's invitedPhones.
      function phoneInvited() {
        return 'invitedPhones' in resource.data
          && exists(/databases/$(database)/documents/users/$(uid()))
          && get(/databases/$(database)/documents/users/$(uid())).data.get('phoneE164', '-') in resource.data.invitedPhones;
      }
      allow read: if signedIn()
        && (uid() in resource.data.memberUids || email() in resource.data.invitedEmails || phoneInvited());

      allow create: if signedIn()
        && request.resource.data.ownerId == uid()
        && uid() in request.resource.data.memberUids
        && (!isDemoUser() || demoGroupOk(request.resource.data));

      // Hosts (owner + hostUids) manage the group. A plain member may only touch
      // their own entry in `members`, remove themselves from memberUids/hostUids
      // (leave), never anyone else's -- before this, any member could rename the
      // group, kick everyone, or make themselves owner. An invited user may
      // accept: add only self to memberUids and clear only their own invite.
      function isGroupHost() {
        return uid() == resource.data.ownerId || uid() in resource.data.get('hostUids', []);
      }
      function ownMembersEntry() {
        return request.resource.data.get('members', {}).diff(resource.data.get('members', {})).affectedKeys().hasOnly([uid()]);
      }
      function memberSelfEdit() {
        let keys = request.resource.data.diff(resource.data).affectedKeys();
        return keys.hasOnly(['members', 'memberUids', 'hostUids'])
          && (!('members' in keys) || ownMembersEntry())
          && (!('memberUids' in keys) || (
               resource.data.memberUids.hasAll(request.resource.data.memberUids)
               && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
               && !(uid() in request.resource.data.memberUids)))
          && (!('hostUids' in keys) || (
               resource.data.get('hostUids', []).hasAll(request.resource.data.get('hostUids', []))
               && !(uid() in request.resource.data.get('hostUids', []))));
      }
      function acceptInvite() {
        let keys = request.resource.data.diff(resource.data).affectedKeys();
        return keys.hasOnly(['memberUids', 'members', 'invitedEmails', 'invitedPhones', 'invitedPhoneNames'])
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && uid() in request.resource.data.memberUids
          && (!('members' in keys) || ownMembersEntry());
      }
      allow update: if signedIn() && (
        isGroupHost()
        || (uid() in resource.data.memberUids && memberSelfEdit())
        || ((email() in resource.data.invitedEmails || phoneInvited()) && acceptInvite())
      ) && (!isDemoUser() || demoGroupOk(request.resource.data));

      allow delete: if signedIn() && uid() == resource.data.ownerId && !(isDemoUser() && groupId == 'demo-squad');

      function isMember() { return signedIn() && uid() in groupMemberUids(groupId); }

      // Group chat — members post; delete your own.
      match /comments/{commentId} {
        allow read: if isMember();
        allow update: if isMember() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
        allow create: if isMember() && request.resource.data.authorId == uid();
        allow delete: if isAdmin() || (signedIn() && resource.data.authorId == uid());
      }
      // Group polls (dates, ideas) — any member adds; members vote (votes map only).
      match /polls/{pollId} {
        allow read, create: if isMember();
        allow update: if isMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']);
        allow delete: if isAdmin() || signedIn() && (resource.data.authorId == uid()
          || uid() == get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId
          || ('hostUids' in get(/databases/$(database)/documents/groups/$(groupId)).data
              && uid() in get(/databases/$(database)/documents/groups/$(groupId)).data.hostUids));
      }
    }

    // ---- Events ----
    // Doc shape: { hostId, cohostUids[], groupId|null, invitedUids[], title,
    //   emoji, date, time, endTime, location, notes, capacity,
    //   rsvps{}, plusOnes{}, hypes{}, createdAt }
    match /events/{eventId} {
      function isHost() {
        return signedIn()
          && (uid() == resource.data.hostId || uid() in resource.data.cohostUids);
      }
      function isInvited() { return signedIn() && uid() in resource.data.invitedUids; }
      function viaGroup() {
        return signedIn() && resource.data.groupId != null
          && uid() in groupMemberUids(resource.data.groupId);
      }
      // An invited (non-host) guest may only edit their own key in a map field.
      function onlyOwn(field) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
          && request.resource.data[field].diff(resource.data.get(field, {})).affectedKeys().hasOnly([uid()]);
      }

      function canReadEvent() {
        let e = get(/databases/$(database)/documents/events/$(eventId)).data;
        return signedIn() && (
          uid() == e.hostId || uid() in e.cohostUids || uid() in e.invitedUids
          || (e.groupId != null && uid() in groupMemberUids(e.groupId))
        );
      }

      // "Anyone with the link can join": the event id is the unguessable secret.
      function openLink() { return signedIn() && 'openLink' in resource.data && resource.data.openLink == true; }
      // The joiner's own phoneE164, for clearing their entry from the host's
      // invitedPhones tracking list on the way in (see selfJoin below).
      function myPhone() {
        return exists(/databases/$(database)/documents/users/$(uid()))
          ? get(/databases/$(database)/documents/users/$(uid())).data.get('phoneE164', '-')
          : '-';
      }
      function selfJoin() {
        let keys = request.resource.data.diff(resource.data).affectedKeys();
        return keys.hasOnly(['invitedUids', 'names', 'invitedPhones', 'invitedPhoneNames', 'joinedVia', 'phoneKeys'])
          && request.resource.data.invitedUids.hasAll(resource.data.invitedUids)
          && request.resource.data.invitedUids.size() == resource.data.invitedUids.size() + 1
          && uid() in request.resource.data.invitedUids
          // may add only their own name
          && (!('names' in keys) || request.resource.data.names.diff(resource.data.get('names', {})).affectedKeys().hasOnly([uid()]))
          && (!('joinedVia' in keys) || request.resource.data.joinedVia.diff(resource.data.get('joinedVia', {})).affectedKeys().hasOnly([uid()]))
          && (!('phoneKeys' in keys) || request.resource.data.phoneKeys.diff(resource.data.get('phoneKeys', {})).affectedKeys().hasOnly([uid()]))
          // may remove only their own number from the pending-invite tracking list, never anyone else's
          && (!('invitedPhones' in keys) || (
               resource.data.get('invitedPhones', []).hasAll(request.resource.data.get('invitedPhones', []))
               && resource.data.get('invitedPhones', []).size() == request.resource.data.get('invitedPhones', []).size() + 1
               && myPhone() in resource.data.get('invitedPhones', [])
               && !(myPhone() in request.resource.data.get('invitedPhones', []))
             ))
          && (!('invitedPhoneNames' in keys) || request.resource.data.get('invitedPhoneNames', {}).diff(resource.data.get('invitedPhoneNames', {})).affectedKeys().hasOnly([myPhone()]));
      }

      allow read: if isHost() || isInvited() || viaGroup() || openLink();
      allow create: if signedIn() && request.resource.data.hostId == uid()
        && (!isDemoUser() || demoEventOk(request.resource.data));
      allow update: if (isHost()
        || (isInvited() && (onlyOwn('rsvps') || onlyOwn('plusOnes') || onlyOwn('plusNames') || onlyOwn('hypes') || onlyOwn('answers')))
        || ((openLink() || viaGroup()) && selfJoin()))
        && (!isDemoUser() || demoEventOk(request.resource.data));
      allow delete: if signedIn() && uid() == resource.data.hostId
        && !(isDemoUser() && eventId in ['demo-evt-1', 'demo-evt-2', 'demo-evt-3']);

      // The event's host or a co-host, for cleaning up other people's items
      // (bring list, rides, wall posts, polls) -- the UI already showed them ✕.
      function isEventHost() {
        let e = get(/databases/$(database)/documents/events/$(eventId)).data;
        return signedIn() && (uid() == e.hostId || uid() in e.get('cohostUids', []));
      }
      // Party wall — anyone who can see the event can post; react; delete your own (hosts: anyone's).
      match /comments/{commentId} {
        allow read: if canReadEvent();
        allow update: if canReadEvent() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
        allow create: if canReadEvent() && request.resource.data.authorId == uid();
        allow delete: if isAdmin() || isEventHost() || (signedIn() && resource.data.authorId == uid());
      }
      // Photos — event guests add and view; remove your own.
      match /photos/{photoId} {
        allow read: if canReadEvent();
        allow create: if canReadEvent() && request.resource.data.addedBy == uid();
        allow delete: if isAdmin() || (signedIn() && resource.data.addedBy == uid());
      }
      // Polls — host adds; any guest can vote (updates only the votes map).
      match /polls/{pollId} {
        allow read: if canReadEvent();
        allow create: if canReadEvent() && request.resource.data.authorId == uid();
        allow update: if canReadEvent()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']);
        allow delete: if isAdmin() || isEventHost() || (signedIn() && resource.data.authorId == uid());
      }
      // Playlist — guests add songs and toggle upvotes (votes map only).
      match /songs/{songId} {
        allow read: if canReadEvent();
        allow create: if canReadEvent() && request.resource.data.addedBy == uid();
        allow update: if canReadEvent()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']);
        allow delete: if isAdmin() || (signedIn() && resource.data.addedBy == uid());
      }
    }

    // ---- Expenses ----
    // Doc shape: { desc, amountCents, paidBy, split[], involved[], eventId,
    //              groupId|null, addedBy, createdAt }.  involved = paidBy + split.
    match /expenses/{expenseId} {
      allow read: if signedIn() && uid() in resource.data.involved;
      allow create: if signedIn()
        && request.resource.data.addedBy == uid()
        && uid() in request.resource.data.involved
        && (!isDemoUser() || request.resource.data.involved.hasOnly(demoUids()));
      allow update, delete: if signedIn() && uid() == resource.data.addedBy;

      // Expense discussion — the people involved can comment; delete your own.
      match /comments/{commentId} {
        function involved() {
          return signedIn() && uid() in get(/databases/$(database)/documents/expenses/$(expenseId)).data.involved;
        }
        allow read: if involved();
        allow update: if involved() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
        allow create: if involved() && request.resource.data.authorId == uid();
        allow delete: if isAdmin() || (signedIn() && resource.data.authorId == uid());
      }
    }

    // ---- AI cover requests ----
    // The client writes { uid, prompt, status:"pending" }; a Cloud Function
    // (Admin SDK, bypasses these rules) fills in the generated image. Each doc
    // is private to the requester, who reads the result and deletes it.
    match /coverRequests/{reqId} {
      allow read, delete: if signedIn() && uid() == resource.data.uid;
      allow create: if signedIn() && request.resource.data.uid == uid()
        && request.resource.data.status == "pending" && !isDemoUser();
    }

    // ---- Receipt reads (same pattern: client writes an image, a function
    //      writes back the itemized data) ----
    match /receiptRequests/{reqId} {
      allow read, delete: if signedIn() && uid() == resource.data.uid;
      allow create: if signedIn() && request.resource.data.uid == uid()
        && request.resource.data.status == "pending" && !isDemoUser();
    }

    // ---- "Let me plan it" (same pattern: client writes what it heard, a function writes back a draft) ----
    match /planRequests/{reqId} {
      allow read, delete: if signedIn() && uid() == resource.data.uid;
      allow create: if signedIn() && request.resource.data.uid == uid()
        && request.resource.data.status == "pending" && !isDemoUser()
        && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 1500));
    }

    // ---- Curate: nights out per city, written by a function; the cities to build for, registered by users ----
    match /curated/{cityKey} {
      allow read: if signedIn();
      match /covers/{coverId} { allow read: if signedIn(); }
    }
    match /curateCities/{cityKey} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.keys().hasOnly(['key', 'city', 'tz', 'updatedAt'])
        && request.resource.data.city is string && request.resource.data.city.size() <= 60;
    }

    // ---- Settlements ----
    // Doc shape: { from, to, amountCents, involved:[from,to], note, addedBy, createdAt }
    match /settlements/{settlementId} {
      allow read: if signedIn() && uid() in resource.data.involved;
      allow create: if signedIn()
        && request.resource.data.addedBy == uid()
        && uid() in request.resource.data.involved
        && (!isDemoUser() || request.resource.data.involved.hasOnly(demoUids()));
      allow update, delete: if signedIn() && uid() == resource.data.addedBy;
    }
  }
}
