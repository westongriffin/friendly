rules_version = '2';
// Friendly — Firestore security rules.
// Real per-group privacy is enforced HERE, on the server. A signed-in stranger
// can never read a group, event, or expense they aren't part of.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function email() { return request.auth.token.email; }
    // App moderators: may read the report queue and remove any user content.
    // Keep in sync with adminUids in firebase-config.js and functions/index.js.
    function isAdmin() {
      return signedIn() && uid() in ['zzJY7MHFnyN2kAqq13hv79rZTVF2', 'TUngQGsAKTRtHBpVEpZwFFHE0sP2'];
    }

    // ---- Activity feed: written by Cloud Functions, readable by its recipients ----
    match /activity/{itemId} {
      allow read: if signedIn() && uid() in resource.data.uids;
    }

    // ---- Reports: anyone signed in can file one; only admins see them ----
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == uid()
        && request.resource.data.status == "open";
      allow read, update, delete: if isAdmin();
    }

    function groupMemberUids(gid) {
      return get(/databases/$(database)/documents/groups/$(gid)).data.memberUids;
    }

    // ---- Users: each profile is private to its owner ----
    match /users/{userId} {
      allow read, write: if signedIn() && userId == uid();
    }

    // ---- Groups ----
    // Doc shape: { name, emoji, ownerId, memberUids[], invitedEmails[],
    //              members: { <uid>: {name, venmo, phone} }, createdAt }
    match /groups/{groupId} {
      allow read: if signedIn()
        && (uid() in resource.data.memberUids || email() in resource.data.invitedEmails);

      allow create: if signedIn()
        && request.resource.data.ownerId == uid()
        && uid() in request.resource.data.memberUids;

      // Owner manages the group; an invited user may accept (adds only self to
      // memberUids, keeping everyone already a member); a member may update the
      // denormalized data (e.g. their own display fields) or leave.
      allow update: if signedIn() && (
        uid() == resource.data.ownerId
        || uid() in resource.data.memberUids
        || (email() in resource.data.invitedEmails
            && request.resource.data.memberUids.hasAll(resource.data.memberUids)
            && uid() in request.resource.data.memberUids)
      );

      allow delete: if signedIn() && uid() == resource.data.ownerId;

      function isMember() { return signedIn() && uid() in groupMemberUids(groupId); }

      // Group chat — members post; delete your own.
      match /comments/{commentId} {
        allow read: if isMember();
        allow create: if isMember() && request.resource.data.authorId == uid();
        allow delete: if isAdmin() || (signedIn() && resource.data.authorId == uid());
      }
      // Group polls (dates, ideas) — any member adds; members vote (votes map only).
      match /polls/{pollId} {
        allow read, create: if isMember();
        allow update: if isMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']);
        allow delete: if isAdmin() || signedIn() && (resource.data.authorId == uid()
          || uid() == get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId);
      }
    }

    // ---- Events ----
    // Doc shape: { hostId, cohostUids[], groupId|null, invitedUids[], title,
    //   emoji, date, time, endTime, location, notes, capacity,
    //   rsvps{}, plusOnes{}, hypes{}, createdAt }
    match /events/{eventId} {
      function isHost() {
        return signedIn()
          && (uid() == resource.data.hostId || uid() in resource.data.cohostUids);
      }
      function isInvited() { return signedIn() && uid() in resource.data.invitedUids; }
      function viaGroup() {
        return signedIn() && resource.data.groupId != null
          && uid() in groupMemberUids(resource.data.groupId);
      }
      // An invited (non-host) guest may only edit their own key in a map field.
      function onlyOwn(field) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
          && request.resource.data[field].diff(resource.data.get(field, {})).affectedKeys().hasOnly([uid()]);
      }

      function canReadEvent() {
        let e = get(/databases/$(database)/documents/events/$(eventId)).data;
        return signedIn() && (
          uid() == e.hostId || uid() in e.cohostUids || uid() in e.invitedUids
          || (e.groupId != null && uid() in groupMemberUids(e.groupId))
        );
      }

      // "Anyone with the link can join": the event id is the unguessable secret.
      function openLink() { return signedIn() && 'openLink' in resource.data && resource.data.openLink == true; }
      function selfJoin() {
        let keys = request.resource.data.diff(resource.data).affectedKeys();
        return keys.hasOnly(['invitedUids', 'names'])
          && request.resource.data.invitedUids.hasAll(resource.data.invitedUids)
          && request.resource.data.invitedUids.size() == resource.data.invitedUids.size() + 1
          && uid() in request.resource.data.invitedUids
          // may add only their own name
          && (!('names' in keys) || request.resource.data.names.diff(resource.data.get('names', {})).affectedKeys().hasOnly([uid()]));
      }

      allow read: if isHost() || isInvited() || viaGroup() || openLink();
      allow create: if signedIn() && request.resource.data.hostId == uid();
      allow update: if isHost()
        || (isInvited() && (onlyOwn('rsvps') || onlyOwn('plusOnes') || onlyOwn('hypes') || onlyOwn('answers')))
        || ((openLink() || viaGroup()) && selfJoin());
      allow delete: if signedIn() && uid() == resource.data.hostId;

      // Party wall — anyone who can see the event can post; delete your own.
      match /comments/{commentId} {
        allow read: if canReadEvent();
        allow create: if canReadEvent() && request.resource.data.authorId == uid();
        allow delete: if isAdmin() || (signedIn() && resource.data.authorId == uid());
      }
      // Photos — event guests add and view; remove your own.
      match /photos/{photoId} {
        allow read: if canReadEvent();
        allow create: if canReadEvent() && request.resource.data.addedBy == uid();
        allow delete: if isAdmin() || (signedIn() && resource.data.addedBy == uid());
      }
      // Polls — host adds; any guest can vote (updates only the votes map).
      match /polls/{pollId} {
        allow read: if canReadEvent();
        allow create: if canReadEvent() && request.resource.data.authorId == uid();
        allow update: if canReadEvent()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']);
        allow delete: if isAdmin() || (signedIn() && resource.data.authorId == uid());
      }
      // Playlist — guests add songs and toggle upvotes (votes map only).
      match /songs/{songId} {
        allow read: if canReadEvent();
        allow create: if canReadEvent() && request.resource.data.addedBy == uid();
        allow update: if canReadEvent()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']);
        allow delete: if isAdmin() || (signedIn() && resource.data.addedBy == uid());
      }
    }

    // ---- Expenses ----
    // Doc shape: { desc, amountCents, paidBy, split[], involved[], eventId,
    //              groupId|null, addedBy, createdAt }.  involved = paidBy + split.
    match /expenses/{expenseId} {
      allow read: if signedIn() && uid() in resource.data.involved;
      allow create: if signedIn()
        && request.resource.data.addedBy == uid()
        && uid() in request.resource.data.involved;
      allow update, delete: if signedIn() && uid() == resource.data.addedBy;

      // Expense discussion — the people involved can comment; delete your own.
      match /comments/{commentId} {
        function involved() {
          return signedIn() && uid() in get(/databases/$(database)/documents/expenses/$(expenseId)).data.involved;
        }
        allow read: if involved();
        allow create: if involved() && request.resource.data.authorId == uid();
        allow delete: if isAdmin() || (signedIn() && resource.data.authorId == uid());
      }
    }

    // ---- AI cover requests ----
    // The client writes { uid, prompt, status:"pending" }; a Cloud Function
    // (Admin SDK, bypasses these rules) fills in the generated image. Each doc
    // is private to the requester, who reads the result and deletes it.
    match /coverRequests/{reqId} {
      allow read, delete: if signedIn() && uid() == resource.data.uid;
      allow create: if signedIn() && request.resource.data.uid == uid()
        && request.resource.data.status == "pending";
    }

    // ---- Receipt reads (same pattern: client writes an image, a function
    //      writes back the itemized data) ----
    match /receiptRequests/{reqId} {
      allow read, delete: if signedIn() && uid() == resource.data.uid;
      allow create: if signedIn() && request.resource.data.uid == uid()
        && request.resource.data.status == "pending";
    }

    // ---- Settlements ----
    // Doc shape: { from, to, amountCents, involved:[from,to], note, addedBy, createdAt }
    match /settlements/{settlementId} {
      allow read: if signedIn() && uid() in resource.data.involved;
      allow create: if signedIn()
        && request.resource.data.addedBy == uid()
        && uid() in request.resource.data.involved;
      allow update, delete: if signedIn() && uid() == resource.data.addedBy;
    }
  }
}
